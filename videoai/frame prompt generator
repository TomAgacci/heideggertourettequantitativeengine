def frame_image_prompt(hypothesis: str,
                       A: float, B: float, C: float,
                       x_star: Optional[float],
                       y_star: Optional[float],
                       checks: Optional[HeideggerChecks]) -> str:
    if x_star is None or y_star is None or checks is None:
        return (f"Abstract, unstable scene evolving from the hypothesis: '{hypothesis}', "
                "with fragmented shapes and shifting balance, representing no coherent fixed point yet.")

    mood = "increasingly harmonious" if checks.overall > 0.7 else \
           "tense and ambiguous" if checks.overall > 0.4 else \
           "chaotic and dissonant"

    return (
        f"{mood} scene inspired by '{hypothesis}', "
        f"with visual motifs slowly morphing as parameters A={A:.2f}, B={B:.2f}, C={C:.2f} evolve. "
        f"Subtly encode the current fixed point ({x_star:.2f}, {y_star:.2f}) as the geometric center of balance."
    )
